# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# Model names (must be pulled in Ollama)
REASONING_MODEL=deepseek-r1:8b
TOOL_MODEL=llama3.1:8b

# Agent settings
MAX_AGENT_TURNS=8

# Swedbank PHP bridge (run: php -S localhost:8080 SwedbankJson/server.php)
SWEDBANK_API_URL=http://localhost:8080
# Bank app type: swedbank, swedbank_foretag, sparbanken, sparbanken_foretag
SWEDBANK_APP_TYPE=swedbank
